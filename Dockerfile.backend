FROM maven:3.9-eclipse-temurin-26 AS build
WORKDIR /app
COPY backend/pom.xml pom.xml
COPY backend/shared-lib/pom.xml shared-lib/pom.xml
COPY backend/api-gateway/pom.xml api-gateway/pom.xml
COPY backend/identity-service/pom.xml identity-service/pom.xml
COPY backend/organization-service/pom.xml organization-service/pom.xml
COPY backend/payment-service/pom.xml payment-service/pom.xml
COPY backend/notification-service/pom.xml notification-service/pom.xml

RUN mvn dependency:go-offline -B || true

COPY backend/ ./

ARG SERVICE_NAME
RUN mvn -pl ${SERVICE_NAME} -am package -DskipTests -B

FROM eclipse-temurin:26-jre
WORKDIR /app
ARG SERVICE_NAME
COPY --from=build /app/${SERVICE_NAME}/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
