{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["cypress", "node"]
  },
  "include": ["./**/*.ts", "../cypress.config.ts", "../cypress.config.local.ts", "../cypress.config.dev.ts"]
}
