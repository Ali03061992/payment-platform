# ============================================================
# NEXTERA - environment template
# Copy to .env and fill values. NEVER commit the real .env file.
# ============================================================

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-0123456789abcdef
JWT_EXPIRATION=30m

# --- Refresh token (identity-service) ---
# TTL du refresh token en jours (rotation à chaque usage). D4 : à confirmer métier.
REFRESH_TOKEN_TTL_DAYS=7
# Cookie HttpOnly pp_rt du refresh token : true en HTTPS, false uniquement en dev local HTTP.
AUTH_COOKIE_SECURE=true

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root-password-change-me
MYSQL_USER=payment_app
MYSQL_PASSWORD=app-password-change-me

# --- RabbitMQ ---
RABBITMQ_USER=payment
RABBITMQ_PASSWORD=rabbit-password-change-me

# --- Elasticsearch ---
ELASTIC_PASSWORD=change-me-elastic-pw

# --- Spring profiles ---
SPRING_PROFILES_ACTIVE=prod

# --- SonarQube (local) ---
# Decommenter pour SonarQube local : http://localhost:9000 (via deploy/docker-compose.sonar.yml)
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=squ_xxx_remplace_par_votre_token

# --- CORS & Rate limiting ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
# URL publique de l'app (liens emails, ex. https://<ip-ou-domaine> sur la VM).
FRONTEND_URL=http://localhost:8080
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
INTERNAL_SECRET=change-me-internal-secret-32chars

# --- Push (Firebase/FCM, M7) ---
# Injectées au build/déploiement front via :
#   envsubst < payment-platform-ui/src/assets/env.template.js \
#     > <dist>/browser/assets/env.js
# Vides = push désactivé proprement. JAMAIS committées.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FCM_VAPID_KEY=

# --- Passkeys / WebAuthn (identity-service) ---
# RP ID = domaine hébergeant la PWA, SANS schéma ni port (ex. : pay.example.tn).
# Requis en profil prod (pas de défaut) ; en dev/local les défauts suffisent.
# WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NEXTERA
# Liste d'origines autorisées (RFC 6454), séparées par des virgules, schéma inclus.
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_TIMEOUT_SECONDS=60

# --- Web Push PWA (notification-service) ---
# Clés VAPID (ECDSA P-256, base64url). Génération :
#   npx web-push generate-vapid-keys
# Vides = paire auto-générée et persistée en base (table vapid_keypairs, dev).
# En prod, fixer les clés ici pour qu'elles survivent aux redémarrages.
WEBPUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@paymentplatform.tn

# --- HTTPS (nginx hôte de la VM, voir docs/TECHNIQUE.md §HTTPS) ---
# TLS terminé par le nginx de la VM (deploy/nginx/host/*), qui proxy vers le
# conteneur angular sur 127.0.0.1:8080. Sur la VM, passer les origines en https.
#
# Domaine public payment.tn (démo PWA + passkeys). Prérequis DNS :
#   payment.tn          A  51.222.6.2
#   www.payment.tn      A  51.222.6.2
#   nextera.payment.tn  A  51.222.6.2
# puis certificat : sudo certbot certonly --webroot -w /var/www/html \
#                     -d payment.tn -d www.payment.tn -d nextera.payment.tn
# et vhost : deploy/nginx/host/payment.tn-https
# CORS_ALLOWED_ORIGINS=https://payment.tn,https://www.payment.tn,https://nextera.payment.tn
# WEBAUTHN_ALLOWED_ORIGINS=https://payment.tn,https://www.payment.tn,https://nextera.payment.tn
# WEBAUTHN_RP_ID=payment.tn   # couvre aussi les sous-domaines (www, nextera)
# FRONTEND_URL=https://nextera.payment.tn   # ou https://payment.tn (liens emails)
#
# Sessions séparées par hôte (cookie pp_rt host-only) : se reconnecter une fois
# par domaine utilisé. Chaque origine installée = une PWA distincte.
# IMPORTANT : supprimer les enregistrements AAAA de payment.tn et www.payment.tn
# (2001:41d0:301::29 = parking OVH) : en IPv6 ils court-circuitent la VM et
# provoquent une erreur de certificat. nextera.payment.tn n'a pas d'AAAA.
#
# Accès secours par IP (sans passkeys) : remplacer par https://51.222.6.2.
# Passkeys : WEBAUTHN_RP_ID exige un domaine réel (pas une IP).